# ==== NumberBank configuration ====
# کپی کنید به .env و مقادیر را تنظیم کنید:  cp .env.example .env

# --- Database ---
# پیش‌فرض: SQLite (بدون نیاز به سرویس). برای مقیاس، PostgreSQL:
#   NUMBERBANK_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/numberbank
NUMBERBANK_DATABASE_URL=sqlite:///data/numberbank.db

# --- HTTP / Crawling (ادب شبکه) ---
NUMBERBANK_USER_AGENT=NumberBankBot/1.0 (+https://github.com/JeyeCode/Number; contact: admin@example.com)
NUMBERBANK_REQUEST_TIMEOUT=20
NUMBERBANK_MAX_RETRIES=3
NUMBERBANK_RESPECT_ROBOTS=true
NUMBERBANK_PER_DOMAIN_RPS=1.0
NUMBERBANK_GLOBAL_CONCURRENCY=8
NUMBERBANK_PROXY_URL=

# --- Search engines ---
# کلیدهای رسمی (اختیاری ولی توصیه‌شده برای پایداری و سرعت)
NUMBERBANK_BING_API_KEY=
NUMBERBANK_GOOGLE_CSE_KEY=
NUMBERBANK_GOOGLE_CSE_CX=
NUMBERBANK_SERPAPI_KEY=
NUMBERBANK_SEARX_INSTANCES=https://searx.be,https://search.bus-hit.me

# --- Queue / Workers ---
NUMBERBANK_QUEUE_BACKEND=sqlite
NUMBERBANK_REDIS_URL=redis://localhost:6379/0
NUMBERBANK_WORKERS=8
NUMBERBANK_JOB_TIME_LIMIT=1800
NUMBERBANK_MAX_ATTEMPTS=3

# --- Discovery defaults ---
NUMBERBANK_MIN_CONFIDENCE=70
NUMBERBANK_DEFAULT_TARGET=1000
NUMBERBANK_MAX_PAGES_PER_QUERY=3
NUMBERBANK_QUERY_REFRESH_DAYS=14
NUMBERBANK_REVALIDATE_AFTER_DAYS=90

# --- Server ---
NUMBERBANK_HOST=0.0.0.0
NUMBERBANK_PORT=8000
NUMBERBANK_LOG_LEVEL=INFO
NUMBERBANK_LOG_DIR=data/logs
